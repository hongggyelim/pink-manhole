# Supabase (Dashboard → Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server only — never expose to the browser
SUPABASE_SECRET_KEY=sb_secret_xxx

# Salt for hashing reporter IPs (any long random string)
IP_HASH_SALT=change-me

# Kakao Developers → 내 애플리케이션 → 앱 키
NEXT_PUBLIC_KAKAO_JS_KEY=
KAKAO_REST_API_KEY=

# Public site origin for absolute share URLs (Open Graph / KakaoTalk previews).
# Optional on Vercel: falls back to the production domain (VERCEL_PROJECT_PRODUCTION_URL).
NEXT_PUBLIC_SITE_URL=https://your-domain.example
